---
layout: portfolio
---
{% assign paper = site.data.research_papers | where: 'id', page.paper_id | first %}
<div class="container paper-detail">
<a class="back-link" href="{{ '/publications/' | relative_url }}">← ALL PUBLICATIONS</a>
<section class="page-intro"><p class="eyebrow">RESEARCH RECORD / {{ paper.short }}</p><div class="paper-meta"><span class="venue-badge">{{ paper.venue }} <b>{{ paper.year }}</b></span><span class="rank-badge">{{ paper.rank }}</span><span class="author-badge">{{ paper.role }}</span><span class="status-badge">{{ paper.status }}</span></div><h1>{{ paper.title }}</h1><p class="authors">{% for author in paper.authors %}{% if author == 'Chengjie Fang' %}<strong>{{ author }}</strong>{% else %}{{ author }}{% endif %}{% if paper.equal contains forloop.index0 %}<sup>*</sup>{% endif %}{% unless forloop.last %}, {% endunless %}{% endfor %}</p>{% if paper.equal %}<p class="source-note">* Equal contribution.</p>{% endif %}<div class="page-actions"><a class="button button-primary" href="{{ paper.id | prepend: '/assets/papers/' | append: '.pdf' | relative_url }}" target="_blank" rel="noopener">READ PAPER ↗</a>{% if paper.code %}<a class="button button-outline" href="{{ paper.code }}" target="_blank" rel="noopener">CODE ↗</a>{% endif %}{% if paper.doi and paper.status == 'Published' %}<a class="text-link" href="https://doi.org/{{ paper.doi }}" target="_blank" rel="noopener">PUBLISHER ↗</a>{% endif %}<a class="text-link" href="{{ paper.id | prepend: '/assets/papers/' | append: '.bib' | relative_url }}" download>BIBTEX ↓</a></div></section>
<figure class="detail-figure"><button type="button" class="paper-figure" data-figure="{{ paper.image | prepend: '/assets/research/' | relative_url }}" data-caption="{{ paper.figure | escape }}" aria-label="Enlarge {{ paper.short }} method figure"><img src="{{ paper.image | prepend: '/assets/research/' | relative_url }}" alt="{{ paper.figure | escape }}"><span class="figure-index">METHOD OVERVIEW</span><span class="figure-enlarge" aria-hidden="true">↗</span></button><figcaption>{{ paper.figure }} Reproduced from the authors' paper.</figcaption></figure>
<div class="detail-overview"><div><p class="eyebrow">METHOD / FINDINGS</p><h2>{{ paper.short }}</h2><p>{{ paper.summary }}</p><p>{{ paper.detail }}</p><p class="result-highlight">{{ paper.highlight }}</p></div><aside class="panel"><p class="eyebrow">PUBLICATION RECORD</p><dl><dt>Venue</dt><dd>{{ paper.venue }} {{ paper.year }}</dd><dt>Classification</dt><dd>{{ paper.rank }}</dd><dt>Author position</dt><dd>{{ paper.position }} of {{ paper.authors.size }}</dd><dt>My authorship</dt><dd>{{ paper.role }}</dd><dt>Status</dt><dd>{{ paper.status }}</dd></dl></aside></div>
<section class="section-block"><div class="section-head"><div><span class="section-id">RELATED WORK</span><h2>Continue exploring<span>.</span></h2></div></div><div class="paper-grid">{% for related in site.data.research_papers %}{% if related.topic == paper.topic and related.id != paper.id %}{% include portfolio_paper.liquid paper=related compact=true %}{% endif %}{% endfor %}</div></section>
</div>
