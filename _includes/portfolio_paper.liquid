{% assign paper = include.paper %}
<article class="paper-card{% if include.compact %} compact{% endif %}" data-topic="{{ paper.topic | escape }}" data-search="{{ paper.title | append: ' ' | append: paper.short | append: ' ' | append: paper.venue | append: ' ' | append: paper.topic | append: ' ' | append: paper.role | downcase | escape }}">
  <button type="button" class="paper-figure" data-figure="{{ paper.image | prepend: '/assets/research/' | relative_url }}" data-caption="{{ paper.figure | escape }}" aria-label="Enlarge {{ paper.short | escape }} method figure"><img src="{{ paper.image | prepend: '/assets/research/' | relative_url }}" alt="{{ paper.figure | escape }}" width="1600" height="900" loading="lazy"><span class="figure-index">{{ paper.short }}</span><span class="figure-enlarge" aria-hidden="true">↗</span></button>
  <div class="paper-copy"><div class="paper-meta"><span class="venue-badge">{{ paper.venue }} <b>{{ paper.year }}</b></span><span class="rank-badge">{{ paper.rank }}</span><span class="author-badge">{{ paper.role }}</span>{% if paper.status == 'Accepted' %}<span class="status-badge">ACCEPTED</span>{% endif %}</div><h3><a href="{{ paper.id | prepend: '/publications/' | append: '/' | relative_url }}">{{ paper.title }}</a></h3><p class="authors">{% for author in paper.authors %}{% if author == 'Chengjie Fang' %}<strong>{{ author }}</strong>{% else %}{{ author }}{% endif %}{% if paper.equal contains forloop.index0 %}<sup>*</sup>{% endif %}{% unless forloop.last %}, {% endunless %}{% endfor %}</p><p class="paper-summary">{{ paper.summary }}</p><div class="paper-links"><a href="{{ paper.id | prepend: '/assets/papers/' | append: '.pdf' | relative_url }}" target="_blank" rel="noopener">PAPER ↗</a>{% if paper.code %}<a href="{{ paper.code }}" target="_blank" rel="noopener">CODE ↗</a>{% endif %}<a href="{{ paper.id | prepend: '/publications/' | append: '/' | relative_url }}">OVERVIEW →</a><a href="{{ paper.id | prepend: '/assets/papers/' | append: '.bib' | relative_url }}" download>BIBTEX ↓</a></div></div>
</article>
