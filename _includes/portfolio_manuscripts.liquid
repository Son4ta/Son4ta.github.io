<div class="manuscript-grid">{% for manuscript in site.data.profile.manuscripts %}<article class="manuscript" id="{{ manuscript.id }}"><p class="eyebrow">{{ manuscript.topic }}</p><div class="paper-meta"><span class="status-badge">UNDER REVIEW</span><span class="author-badge">{{ manuscript.role }}</span></div><h3>{{ manuscript.title }}</h3><p>{{ manuscript.summary }}</p></article>{% endfor %}</div>
